<UserControl x:Class="rocnikový_projekt.Scena2"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Viewbox Stretch="Fill">

        <Grid Width="800" Height="450">

            <Image Source="/imgs/scene2.png" Stretch="Fill"/>

            <!-- POSTEL -->
            <Button Width="120" Height="80"
                    Margin="106,270,574,100"
                    Opacity="0.01"
                    Click="KlikPostel"/>

            <!-- OBRAZ -->
            <Button Width="120" Height="120"
                    Margin="86,105,594,225"
                    Opacity="0.01"
                    Click="KlikObraz"/>

            <!-- STĚNA -->
            <Button Width="120"
                    Margin="598,128,82,140"
                    Opacity="0.01"
                    Click="KlikStena"/>

            <!-- KŮLNA -->
            <Button Width="80" Height="120"
                    Margin="483,190,237,140"
                    Opacity="0.01"
                    Click="KlikKulna"/>

            <!-- DVEŘE -->
            <Button Width="100" Height="150"
                    Margin="315,128,385,172"
                    Opacity="0.01"
                    Click="KlikDvere"/>

            <!-- TEXT -->
            <Border Background="#AA000000"
                    Height="80"
                    VerticalAlignment="Bottom">
                <TextBlock x:Name="TextPopis"
                           Foreground="White"
                           FontSize="16"
                           Margin="10"/>
            </Border>

        </Grid>

    </Viewbox>
</UserControl>