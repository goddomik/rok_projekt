<Window x:Class="rocnikový_projekt.Heslookno"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zadej zprávu"
        Height="200"
        Width="400">

    <Grid>

        <TextBox x:Name="TextHeslo"
                 Width="250"
                 Height="40"
                 FontSize="20"
                 VerticalAlignment="Center"/>

        <Button Content="Potvrdit"
                Width="120"
                Height="40"
                VerticalAlignment="Bottom"
                Margin="0,0,0,20"
                Click="PotvrditKlik"/>

    </Grid>
</Window>