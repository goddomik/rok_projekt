<UserControl x:Class="rocnikový_projekt.Scena1"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Viewbox Stretch="Fill">

        <Grid Width="800" Height="450">

            <Image Source="/imgs/scene1.jpeg" Stretch="Fill"/>

            <!-- DVEŘE -->
            <Button
                    Margin="480,172,232,132"
                    Opacity="0.01"
                    Click="KlikDvere"/>

            <!-- OKNO -->
            <Button Width="120" Height="80"
                    Margin="330,205,350,165"
                    Opacity="0.01"
                    Click="KlikOkno"/>

            <!-- KEŘ -->
            <Button Width="120" Height="80"
                    Margin="64,245,616,125"
                    Opacity="0.01"
                    Click="KlikKer"/>

            <!-- TEXT -->
            <Border Background="#AA000000"
                    Height="80"
                    VerticalAlignment="Bottom">
                <TextBlock x:Name="TextPopis"
                           Foreground="White"
                           FontSize="16"
                           Margin="10"/>
            </Border>

        </Grid>

    </Viewbox>
</UserControl>